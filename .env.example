# Database (PostgreSQL — local development instance only, never production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncc_dev?schema=public"
# Production uses the Supabase session pooler (port 5432, ?sslmode=require), never the direct db.<project-ref>.supabase.co hostname.

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed (development only - use strong passwords!)
SEED_ADMIN_EMAIL="admin@ncc-mitwpu.edu.in"
SEED_ADMIN_PASSWORD="your-strong-admin-password-min-12-chars"
