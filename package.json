{
  "name": "ncc-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:guard": "node scripts/prisma-guard.mjs check",
    "db:migrate:dev": "node scripts/prisma-guard.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma-guard.mjs migrate deploy",
    "db:migrate:status": "node scripts/prisma-guard.mjs migrate status",
    "db:migrate:resolve": "node scripts/prisma-guard.mjs migrate resolve",
    "db:push": "node scripts/prisma-guard.mjs db push",
    "db:seed": "node scripts/prisma-guard.mjs exec npx tsx prisma/seed.ts",
    "db:diff": "node scripts/prisma-guard.mjs migrate diff",
    "test": "node --test scripts/prisma-guard.test.mjs scripts/prisma-target.test.mjs scripts/user-exposure.test.mjs",
    "test:guard": "node --test scripts/prisma-guard.test.mjs",
    "test:target": "node --test scripts/prisma-target.test.mjs",
    "test:exposure": "node --test scripts/user-exposure.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.4.1",
    "@supabase/storage-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "exceljs": "^3.4.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
