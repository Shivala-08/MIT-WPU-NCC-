# Database (PostgreSQL — local development instance only, never production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncc_dev?schema=public"
# Production uses the Supabase session pooler (port 5432, ?sslmode=require), never the direct db.<project-ref>.supabase.co hostname.

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (required for sign-in; from Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Audit trail (required in production, at least 16 characters, a dedicated value)
# The key of the email references of the audit trail. It must be different from
# NEXTAUTH_SECRET, AUTH_SECRET and ATTENDANCE_CODE_SECRET. In development the
# application falls back to the other secrets of the machine and, if none of
# them is set, to a random key of the process.
# AUDIT_HASH_KEY="generate with: openssl rand -hex 32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Profile photo storage (private)
# "supabase" uses a private Supabase Storage bucket, "local" stores the files
# in .local-storage/ and is for development only.
PROFILE_PHOTO_STORAGE="local"
PROFILE_PHOTO_BUCKET="profile-photos"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Seed (development only - use strong passwords!)
SEED_ADMIN_EMAIL="admin@ncc-mitwpu.edu.in"
SEED_ADMIN_PASSWORD="your-strong-admin-password-min-12-chars"
# SEED_CREATE_CADET="true"
# SEED_CADET_EMAIL="cadet@mitwpu.edu.in"
# SEED_CADET_PASSWORD="your-strong-cadet-password-min-12-chars"
